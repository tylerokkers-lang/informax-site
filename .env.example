# Required for the /enquire form to actually send email (via Resend).
# Without this, submissions validate correctly but show an honest error
# instead of a false success. See README.md for details.
RESEND_API_KEY=

# Optional overrides
ENQUIRY_TO_EMAIL=info@informax.co.uk
ENQUIRY_FROM_EMAIL="Informax Enquiries <enquiries@informax.co.uk>"

# Verified Cloud signup endpoint after the new application is ready. No V1 fallback.
# HTTPS URL; selected plan is forwarded as ?plan=annual or ?plan=monthly.
CLOUD_SIGNUP_URL=
